/*
 * Custom lock behaviors for the two sticky trackball layers (Scroll + Snipe).
 *
 * Both are sticky: you engage them and they stay put, leaving the ball hand
 * free. Each button gives three actions:
 *   tap         -> its key            (Escape for scroll, Close/MB5 for snipe)
 *   hold        -> momentary layer     (&mo LAYER_*)
 *   double-tap  -> lock/unlock layer   (&tog LAYER_*)
 * Once locked, a single tap of the layer's own button (bound to &tog on that
 * layer) drops back out.
 *
 * Media is momentary on pos0 (Enter tap / Media hold) and sits above Snipe in
 * the layer stack so its encoders win while held; it does not use a lock
 * behavior here. Enter stays on pos0. Tap keys on pos6/pos7 are Close (MB5)
 * on the snipe button and Back (MB4) on the system button (kp-only swap vs
 * the hold layers).
 *
 * IMPORTANT ordering: each is a tap-dance (outer) wrapping a hold-tap (inner).
 * The reverse -- a hold-tap wrapping a tap-dance -- does NOT work: each tap
 * resolves through the hold-tap separately, so the inner tap-dance never counts
 * to two and the double-tap lock never fires. With the tap-dance on the outside
 * it owns the tap counting, and its timer passes a held press straight through
 * to the inner hold-tap (so hold still reaches the layer).
 *
 * Trade-off: because the same key must wait to see whether a second tap is
 * coming, the momentary-layer hold has some added latency.
 *
 * Bound in the keymap as `&ltlk` (scroll), `&snlk` (snipe), and `&syslk`
 * (close / system / reload). All are 0-cell (the layer + tap key are baked in
 * below). LAYER_SCROLL / LAYER_SNIPE / LAYER_SYSTEM must be defined (in the
 * keymap) before this file is included.
 */

/ {
	behaviors {
		// Shared inner hold-tap: hold -> &mo <layer>, tap -> &kp <key>.
		lk_ht: lk_ht {
			compatible = "zmk,behavior-hold-tap";
			display-name = "Momentary layer / key (hold/tap)";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <150>;
			bindings = <&mo>, <&kp>;
		};

		// Same as lk_ht but tap is a mouse button (&mkp).
		lk_htm: lk_htm {
			compatible = "zmk,behavior-hold-tap";
			display-name = "Momentary layer / mouse key (hold/tap)";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <150>;
			bindings = <&mo>, <&mkp>;
		};

		ltlk: ltlk {
			compatible = "zmk,behavior-tap-dance";
			display-name = "Escape / scroll / lock (tap/hold/double-tap)";
			#binding-cells = <0>;
			// Was 200 ms — too short to reliably double-tap lock.
			tapping-term-ms = <350>;
			bindings = <&lk_ht LAYER_SCROLL ESC>, <&tog LAYER_SCROLL>;
		};

		/* pos6: hold/2× = snipe; tap = Close (MB5). Back lives on syslk. */
		snlk: snlk {
			compatible = "zmk,behavior-tap-dance";
			display-name = "Close / snipe / lock (tap/hold/double-tap)";
			#binding-cells = <0>;
			tapping-term-ms = <350>;
			bindings = <&lk_htm LAYER_SNIPE MB5>, <&tog LAYER_SNIPE>;
		};

		/* pos7: hold = System; tap = Back (MB4); double-tap = reload.
		 * Tap-dance stays outside the hold-tap, same reason as ltlk/snlk.
		 */
		syslk: syslk {
			compatible = "zmk,behavior-tap-dance";
			display-name = "Back / system / reload (tap/hold/double-tap)";
			#binding-cells = <0>;
			tapping-term-ms = <350>;
			bindings = <&lk_htm LAYER_SYSTEM MB4>, <&kp RC(A)>;
		};
	};
};
