/*
 * Custom behavior for the Escape / scroll-layer button.
 *
 * `ltlk` gives three actions on one key:
 *   tap         -> Escape
 *   hold        -> momentary scroll layer   (&mo LAYER_SCROLL)
 *   double-tap  -> lock/unlock scroll layer (&tog LAYER_SCROLL)
 *
 * IMPORTANT ordering: this is a tap-dance (outer) that wraps a hold-tap
 * (inner). The reverse -- a hold-tap wrapping a tap-dance -- does NOT work:
 * each tap resolves through the hold-tap separately, so the inner tap-dance
 * never counts to two and the double-tap lock never fires. With the tap-dance
 * on the outside it owns the tap counting, and its timer passes a held press
 * straight through to the inner hold-tap (so hold still reaches the layer).
 *
 * Trade-off: because the same key must wait to see whether a second tap is
 * coming, the momentary-scroll hold has some added latency. (The copy button,
 * `&cdch LAYER_SCROLL 0`, still gives instant hold-to-scroll if you want it.)
 *
 * Bound in the keymap as `&ltlk` (0 cells; the layer is baked in below).
 * LAYER_SCROLL must be defined (in the keymap) before this file is included.
 */

/ {
	behaviors {
		ltlk_ht: ltlk_ht {
			compatible = "zmk,behavior-hold-tap";
			display-name = "Escape / momentary scroll (tap/hold)";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <150>;
			bindings = <&mo>, <&kp>;
		};

		ltlk: ltlk {
			compatible = "zmk,behavior-tap-dance";
			display-name = "Escape / scroll / lock (tap/hold/double-tap)";
			#binding-cells = <0>;
			tapping-term-ms = <200>;
			bindings = <&ltlk_ht LAYER_SCROLL ESC>, <&tog LAYER_SCROLL>;
		};
	};
};
