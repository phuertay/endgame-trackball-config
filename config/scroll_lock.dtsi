/*
 * Custom behavior for the Escape / scroll-layer button.
 *
 * `ltlk` ("layer-tap-lock") replaces the stock `&ltmkp LAYER_SCROLL ESC` on the
 * default layer. It keeps the original hold-to-scroll and tap-for-Escape, and
 * adds a *double-tap* that locks (toggles) the scroll layer:
 *
 *   hold          -> momentary scroll layer   (&mo, param 1 = the layer)
 *   single tap    -> Escape                    (&kp ESC)
 *   double tap    -> lock/unlock scroll layer  (&tog LAYER_SCROLL)
 *
 * `LAYER_SCROLL` must be defined (in the keymap) before this file is included.
 */

/ {
	behaviors {
		esc_lock: escape-lock {
			compatible = "zmk,behavior-tap-dance";
			display-name = "Escape / lock scroll (tap/double-tap)";
			#binding-cells = <0>;
			tapping-term-ms = <250>;
			bindings = <&kp ESC>, <&tog LAYER_SCROLL>;
		};

		ltlk: layer-tap-lock {
			compatible = "zmk,behavior-hold-tap";
			display-name = "Escape / lock-scroll / scroll (tap/double-tap/hold)";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <200>;
			hold-while-undecided;
			bindings = <&mo>, <&esc_lock>;
		};
	};
};
