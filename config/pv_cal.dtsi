/*
 * TEMPORARY Neu paste-values timing calibration — ROUND 3
 *
 * Round 2: E300/E350 fail; E400/E450 ok; W100/W150 ok; E500@W250 ok.
 * Enter floor ∈ (350, 400]; Win floor ≤ 100 (with Enter=1000).
 *
 * Combo both lower buttons (pos 6+7) toggles LAYER_PV_CAL. Leave with pos7.
 *
 *   Top     = ENTER between 350 and 400 (Win=500)
 *               pos0 E360 | pos1 E375
 *               pos2 E390 | pos3 E400@W250  ← likely production candidate
 *   Bottom  = Enter floor × fast Win
 *               pos4 E400@W100 | pos5 E400@W150
 *               pos6 E450@W100 | pos7 BACK
 *
 * Report ok/fail per key. If E400@W100 works, that's the aggressive lock-in.
 */

#define PV_CAL_HOLD 12
#define PV_CAL_GAP  50

/ {
	macros {
		pv_e360: pv_e360 {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <PV_CAL_GAP>;
			tap-ms = <PV_CAL_HOLD>;
			bindings
				= <&macro_press &kp LGUI>
				, <&macro_wait_time PV_CAL_HOLD>
				, <&macro_press &kp FSLH>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_release &kp FSLH>
				, <&macro_wait_time 500>
				, <&macro_release &kp LGUI>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp TAB>
				, <&macro_wait_time 360>
				, <&macro_tap &kp RET>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp RET>;
		};
		pv_e375: pv_e375 {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <PV_CAL_GAP>;
			tap-ms = <PV_CAL_HOLD>;
			bindings
				= <&macro_press &kp LGUI>
				, <&macro_wait_time PV_CAL_HOLD>
				, <&macro_press &kp FSLH>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_release &kp FSLH>
				, <&macro_wait_time 500>
				, <&macro_release &kp LGUI>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp TAB>
				, <&macro_wait_time 375>
				, <&macro_tap &kp RET>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp RET>;
		};
		pv_e390: pv_e390 {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <PV_CAL_GAP>;
			tap-ms = <PV_CAL_HOLD>;
			bindings
				= <&macro_press &kp LGUI>
				, <&macro_wait_time PV_CAL_HOLD>
				, <&macro_press &kp FSLH>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_release &kp FSLH>
				, <&macro_wait_time 500>
				, <&macro_release &kp LGUI>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp TAB>
				, <&macro_wait_time 390>
				, <&macro_tap &kp RET>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp RET>;
		};
		pv_e400w250: pv_e400w250 {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <PV_CAL_GAP>;
			tap-ms = <PV_CAL_HOLD>;
			bindings
				= <&macro_press &kp LGUI>
				, <&macro_wait_time PV_CAL_HOLD>
				, <&macro_press &kp FSLH>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_release &kp FSLH>
				, <&macro_wait_time 250>
				, <&macro_release &kp LGUI>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp TAB>
				, <&macro_wait_time 400>
				, <&macro_tap &kp RET>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp RET>;
		};
		pv_e400w100: pv_e400w100 {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <PV_CAL_GAP>;
			tap-ms = <PV_CAL_HOLD>;
			bindings
				= <&macro_press &kp LGUI>
				, <&macro_wait_time PV_CAL_HOLD>
				, <&macro_press &kp FSLH>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_release &kp FSLH>
				, <&macro_wait_time 100>
				, <&macro_release &kp LGUI>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp TAB>
				, <&macro_wait_time 400>
				, <&macro_tap &kp RET>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp RET>;
		};
		pv_e400w150: pv_e400w150 {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <PV_CAL_GAP>;
			tap-ms = <PV_CAL_HOLD>;
			bindings
				= <&macro_press &kp LGUI>
				, <&macro_wait_time PV_CAL_HOLD>
				, <&macro_press &kp FSLH>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_release &kp FSLH>
				, <&macro_wait_time 150>
				, <&macro_release &kp LGUI>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp TAB>
				, <&macro_wait_time 400>
				, <&macro_tap &kp RET>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp RET>;
		};
		pv_e450w100: pv_e450w100 {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <PV_CAL_GAP>;
			tap-ms = <PV_CAL_HOLD>;
			bindings
				= <&macro_press &kp LGUI>
				, <&macro_wait_time PV_CAL_HOLD>
				, <&macro_press &kp FSLH>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_release &kp FSLH>
				, <&macro_wait_time 100>
				, <&macro_release &kp LGUI>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp TAB>
				, <&macro_wait_time 450>
				, <&macro_tap &kp RET>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp RET>;
		};
	};
};
