/*
 * TEMPORARY Neu paste-values timing calibration — ROUND 2
 *
 * Round 1 result: only top-left failed → E250@W500 fail; all else ok.
 * So Enter floor is in (250, 500]; Win floor is ≤250 (with Enter=1000).
 *
 * Combo both lower buttons (pos 6+7) toggles LAYER_PV_CAL. Leave with pos7.
 *
 *   Top four  = ENTER fine sweep, Win fixed at 500
 *               pos0 E300 | pos1 E350
 *               pos2 E400 | pos3 E450
 *   Bottom    = Win below 250 (Enter=1000) + combined mins
 *               pos4 W100 | pos5 W150
 *               pos6 E500@W250 | pos7 BACK
 *               (pos6 = round-1 mins combined: does E500 still work at W250?)
 *
 * Report ok/fail per key.
 */

#define PV_CAL_HOLD 12
#define PV_CAL_GAP  50

/ {
	macros {
		/* ENTER fine sweep (Win = 500) */
		pv_e300: pv_e300 {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <PV_CAL_GAP>;
			tap-ms = <PV_CAL_HOLD>;
			bindings
				= <&macro_press &kp LGUI>
				, <&macro_wait_time PV_CAL_HOLD>
				, <&macro_press &kp FSLH>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_release &kp FSLH>
				, <&macro_wait_time 500>
				, <&macro_release &kp LGUI>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp TAB>
				, <&macro_wait_time 300>
				, <&macro_tap &kp RET>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp RET>;
		};
		pv_e350: pv_e350 {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <PV_CAL_GAP>;
			tap-ms = <PV_CAL_HOLD>;
			bindings
				= <&macro_press &kp LGUI>
				, <&macro_wait_time PV_CAL_HOLD>
				, <&macro_press &kp FSLH>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_release &kp FSLH>
				, <&macro_wait_time 500>
				, <&macro_release &kp LGUI>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp TAB>
				, <&macro_wait_time 350>
				, <&macro_tap &kp RET>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp RET>;
		};
		pv_e400: pv_e400 {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <PV_CAL_GAP>;
			tap-ms = <PV_CAL_HOLD>;
			bindings
				= <&macro_press &kp LGUI>
				, <&macro_wait_time PV_CAL_HOLD>
				, <&macro_press &kp FSLH>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_release &kp FSLH>
				, <&macro_wait_time 500>
				, <&macro_release &kp LGUI>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp TAB>
				, <&macro_wait_time 400>
				, <&macro_tap &kp RET>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp RET>;
		};
		pv_e450: pv_e450 {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <PV_CAL_GAP>;
			tap-ms = <PV_CAL_HOLD>;
			bindings
				= <&macro_press &kp LGUI>
				, <&macro_wait_time PV_CAL_HOLD>
				, <&macro_press &kp FSLH>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_release &kp FSLH>
				, <&macro_wait_time 500>
				, <&macro_release &kp LGUI>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp TAB>
				, <&macro_wait_time 450>
				, <&macro_tap &kp RET>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp RET>;
		};

		/* Win below 250 (Enter = 1000) */
		pv_w100: pv_w100 {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <PV_CAL_GAP>;
			tap-ms = <PV_CAL_HOLD>;
			bindings
				= <&macro_press &kp LGUI>
				, <&macro_wait_time PV_CAL_HOLD>
				, <&macro_press &kp FSLH>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_release &kp FSLH>
				, <&macro_wait_time 100>
				, <&macro_release &kp LGUI>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp TAB>
				, <&macro_wait_time 1000>
				, <&macro_tap &kp RET>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp RET>;
		};
		pv_w150: pv_w150 {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <PV_CAL_GAP>;
			tap-ms = <PV_CAL_HOLD>;
			bindings
				= <&macro_press &kp LGUI>
				, <&macro_wait_time PV_CAL_HOLD>
				, <&macro_press &kp FSLH>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_release &kp FSLH>
				, <&macro_wait_time 150>
				, <&macro_release &kp LGUI>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp TAB>
				, <&macro_wait_time 1000>
				, <&macro_tap &kp RET>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp RET>;
		};

		/* Round-1 mins combined: Enter 500 (ok) + Win 250 (ok separately) */
		pv_e500w250: pv_e500w250 {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			wait-ms = <PV_CAL_GAP>;
			tap-ms = <PV_CAL_HOLD>;
			bindings
				= <&macro_press &kp LGUI>
				, <&macro_wait_time PV_CAL_HOLD>
				, <&macro_press &kp FSLH>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_release &kp FSLH>
				, <&macro_wait_time 250>
				, <&macro_release &kp LGUI>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp TAB>
				, <&macro_wait_time 500>
				, <&macro_tap &kp RET>
				, <&macro_wait_time PV_CAL_GAP>
				, <&macro_tap &kp RET>;
		};
	};
};
