/*
 * Extra layout-aware (bistable) shortcuts for the Edit layer.
 *
 * Same idea as clipboard_layouts.dtsi: slot 0 = Terminator (kbdterm),
 * slot 1 = Neu (kbdneu); `bst_tog` flips both. All use Right Ctrl (Neu remaps
 * Left Ctrl).
 *
 * paste-values:
 *   Terminator -> Win+F13 (dacman)              : LG(F13)
 *   Neu        -> Win+V clipboard history, then Tab, Enter, wait, Enter
 *                (opens the picker, selects the top item, confirms paste)
 *
 * unclose-tab = Ctrl+Shift+T:
 *   Terminator -> T is at physical "`" (grave) -> RC(LS(GRAVE))
 *   Neu        -> T is at physical "F"          -> RC(LS(F))
 *
 * Excel QAT: tap Alt (keytips), then the digit — simultaneous Alt+digit is
 * unreliable for some Excel builds.
 */

/ {
	macros {
		winlin_pv: winlin_pv {
			compatible = "zmk,behavior-macro";
			display-name = "Paste values (Terminator)";
			#binding-cells = <0>;
			wait-ms = <10>;
			bindings = <&kp LG(F13)>;
		};
		macos_pv: macos_pv {
			compatible = "zmk,behavior-macro";
			display-name = "Paste values (Neu, Win+V clipboard)";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings
				= <&macro_press &kp LGUI>
				, <&macro_tap &kp FSLH>
				, <&macro_release &kp LGUI>
				, <&macro_tap &kp TAB>
				, <&macro_tap &kp RET>
				, <&macro_wait_time 10>
				, <&macro_tap &kp RET>;
		};

		winlin_unclose: winlin_unclose {
			compatible = "zmk,behavior-macro";
			display-name = "Reopen tab (Terminator)";
			#binding-cells = <0>;
			wait-ms = <10>;
			bindings = <&kp RC(LS(GRAVE))>;
		};
		macos_unclose: macos_unclose {
			compatible = "zmk,behavior-macro";
			display-name = "Reopen tab (Neu)";
			#binding-cells = <0>;
			wait-ms = <10>;
			bindings = <&kp RC(LS(F))>;
		};

		/*
		 * Excel "Paste & Transpose Values" -- mirrors the Z mouse macro exactly:
		 *   RCtrl+LAlt+/ , release Ctrl , Alt+/ , Alt+K , release Alt , Enter
		 * i.e. Ctrl+Alt+V (Paste Special), then the dialog accelerators Alt+V
		 * (Values) and Alt+E (Transpose), then OK.
		 *
		 * Layout-independent across BOTH Terminator and Neu (unlike copy/paste):
		 * this sequence only uses 'V' and 'E', and in both layouts 'V' sits on
		 * physical "/" (FSLH) and 'E' on physical "K" -- the same physical keys
		 * (only C/X/Z differ). Right Ctrl is used because Neu remaps Left Ctrl.
		 *
		 * Alt is held across the V/E taps (the reliable dialog-accelerator form),
		 * and there's no artificial delay -- the Z config inserts no wait here;
		 * Windows buffers the keystrokes until the Paste Special dialog appears.
		 */
		ptv: ptv {
			compatible = "zmk,behavior-macro";
			display-name = "Paste transpose values (Excel)";
			#binding-cells = <0>;
			wait-ms = <20>;
			tap-ms = <10>;
			bindings
				= <&macro_press &kp RCTRL &kp LALT>
				, <&macro_tap &kp FSLH>
				, <&macro_release &kp RCTRL>
				, <&macro_tap &kp FSLH>
				, <&macro_tap &kp K>
				, <&macro_release &kp LALT>
				, <&macro_tap &kp RET>;
		};

		/* Excel QAT: Alt tap → digit (keytips), not simultaneous Alt+digit. */
		qat1: qat1 {
			compatible = "zmk,behavior-macro";
			display-name = "QAT 1 (Paste Format)";
			#binding-cells = <0>;
			wait-ms = <30>;
			tap-ms = <10>;
			bindings = <&macro_tap &kp LALT>, <&macro_tap &kp N1>;
		};
		qat3: qat3 {
			compatible = "zmk,behavior-macro";
			display-name = "QAT 3 (Paste Formulas)";
			#binding-cells = <0>;
			wait-ms = <30>;
			tap-ms = <10>;
			bindings = <&macro_tap &kp LALT>, <&macro_tap &kp N3>;
		};
		qat6: qat6 {
			compatible = "zmk,behavior-macro";
			display-name = "QAT 6 (Copy as Picture)";
			#binding-cells = <0>;
			wait-ms = <30>;
			tap-ms = <10>;
			bindings = <&macro_tap &kp LALT>, <&macro_tap &kp N6>;
		};
		qat8: qat8 {
			compatible = "zmk,behavior-macro";
			display-name = "QAT 8 (Rev Transpose)";
			#binding-cells = <0>;
			wait-ms = <30>;
			tap-ms = <10>;
			bindings = <&macro_tap &kp LALT>, <&macro_tap &kp N8>;
		};
	};

	behaviors {
		pv: pv {
			compatible = "zmk,behavior-bistable";
			display-name = "Paste values (layout)";
			#binding-cells = <0>;
			bindings = <&winlin_pv>, <&macos_pv>;
		};
		unclose: unclose {
			compatible = "zmk,behavior-bistable";
			display-name = "Reopen tab (layout)";
			#binding-cells = <0>;
			bindings = <&winlin_unclose>, <&macos_unclose>;
		};

		axlk: axlk {
			compatible = "zmk,behavior-axis-lock-toggle";
			display-name = "Toggle scroll axis (Y/X)";
			#binding-cells = <0>;
		};
	};
};
