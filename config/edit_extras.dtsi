/*
 * Extra layout-aware (bistable) shortcuts for the Edit layer.
 *
 * Same idea as clipboard_layouts.dtsi: slot 0 = Terminator (kbdterm),
 * slot 1 = Neu (kbdneu); `bst_tog` flips both. All use Right Ctrl (Neu remaps
 * Left Ctrl).
 *
 * paste-values:
 *   Terminator -> Win+F13 (dacman)              : LG(F13)
 *   Neu        -> Win+V, wait, Tab, Enter, wait, Enter
 *
 * Excel QAT (format / formulas / rev transpose): same as zmk-config numpad
 * `m_las_n*` — tap Alt, wait 15ms, Shift+digit.
 * Paste & transpose values: same as zmk-config `m_paste_transp`.
 * Copy-as-picture stays Shift+Alt+6.
 */

#define MACRO_WAIT_LAS   15
#define MACRO_WAIT_CHORD 40

/ {
	macros {
		winlin_pv: winlin_pv {
			compatible = "zmk,behavior-macro";
			display-name = "Paste values (Terminator)";
			#binding-cells = <0>;
			wait-ms = <10>;
			bindings = <&kp LG(F13)>;
		};
		macos_pv: macos_pv {
			compatible = "zmk,behavior-macro";
			display-name = "Paste values (Neu, Win+V clipboard)";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings
				= <&macro_press &kp LGUI>
				, <&macro_tap &kp FSLH>
				, <&macro_release &kp LGUI>
				, <&macro_wait_time 100>
				, <&macro_tap &kp TAB>
				, <&macro_tap &kp RET>
				, <&macro_wait_time 100>
				, <&macro_tap &kp RET>;
		};

		winlin_unclose: winlin_unclose {
			compatible = "zmk,behavior-macro";
			display-name = "Reopen tab (Terminator)";
			#binding-cells = <0>;
			wait-ms = <10>;
			bindings = <&kp RC(LS(GRAVE))>;
		};
		macos_unclose: macos_unclose {
			compatible = "zmk,behavior-macro";
			display-name = "Reopen tab (Neu)";
			#binding-cells = <0>;
			wait-ms = <10>;
			bindings = <&kp RC(LS(F))>;
		};

		/* Same as zmk-config m_paste_transp on the numpad layer. */
		ptv: ptv {
			compatible = "zmk,behavior-macro";
			display-name = "Paste transpose values (Excel)";
			#binding-cells = <0>;
			wait-ms = <MACRO_WAIT_CHORD>;
			tap-ms = <1>;
			bindings = <&kp RC(LA(FSLH)) &kp LA(FSLH) &kp K &kp ENTER>;
		};

		/* Same as zmk-config m_las_n*: Alt, wait 15ms, Shift+digit. */
		qat1: qat1 {
			compatible = "zmk,behavior-macro";
			display-name = "QAT 1 (Paste Format)";
			#binding-cells = <0>;
			wait-ms = <3>;
			tap-ms = <1>;
			bindings
				= <&kp LALT>
				, <&macro_wait_time MACRO_WAIT_LAS>
				, <&kp LS(N1)>;
		};
		qat3: qat3 {
			compatible = "zmk,behavior-macro";
			display-name = "QAT 3 (Paste Formulas)";
			#binding-cells = <0>;
			wait-ms = <3>;
			tap-ms = <1>;
			bindings
				= <&kp LALT>
				, <&macro_wait_time MACRO_WAIT_LAS>
				, <&kp LS(N3)>;
		};
		qat6: qat6 {
			compatible = "zmk,behavior-macro";
			display-name = "QAT 6 (Copy as Picture)";
			#binding-cells = <0>;
			wait-ms = <10>;
			tap-ms = <10>;
			bindings
				= <&macro_press &kp LSHFT &kp LALT>
				, <&macro_tap &kp N6>
				, <&macro_release &kp LALT &kp LSHFT>;
		};
		qat8: qat8 {
			compatible = "zmk,behavior-macro";
			display-name = "QAT 8 (Rev Transpose)";
			#binding-cells = <0>;
			wait-ms = <3>;
			tap-ms = <1>;
			bindings
				= <&kp LALT>
				, <&macro_wait_time MACRO_WAIT_LAS>
				, <&kp LS(N8)>;
		};
	};

	behaviors {
		pv: pv {
			compatible = "zmk,behavior-bistable";
			display-name = "Paste values (layout)";
			#binding-cells = <0>;
			bindings = <&winlin_pv>, <&macos_pv>;
		};
		unclose: unclose {
			compatible = "zmk,behavior-bistable";
			display-name = "Reopen tab (layout)";
			#binding-cells = <0>;
			bindings = <&winlin_unclose>, <&macos_unclose>;
		};

		axlk: axlk {
			compatible = "zmk,behavior-axis-lock";
			display-name = "Scroll axis (tap toggle / hold swap)";
			#binding-cells = <0>;
			tapping-term-ms = <200>;
		};
	};
};
