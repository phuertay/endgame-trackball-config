/*
 * App switch: two modes.
 *
 * Default layer: middle button stays undecided until you either move the ball
 * (middle-click hold / drag) or turn the left encoder (`&mea` → one Alt+Tab
 * chord per detent). Release with neither → middle-click tap.
 *
 * Edit / Excel: encoder Alt-Tab swapper (`&at`) with a short commit window;
 * every tick re-asserts Alt so mid-session drops recover.
 */

#include <dt-bindings/zmk/keys.h>

/ {
	behaviors {
		at: alt_tab {
			compatible = "zmk,behavior-alt-tab";
			display-name = "Alt-Tab (app switch)";
			#binding-cells = <1>;
			hold-key = <LEFT_ALT>;
			/* Short so the switcher commits quickly after you stop spinning.
			 * Alt is re-asserted on every tick (see behavior_alt_tab.c). */
			release-after-ms = <450>;
		};

		mca: mclk-alt {
			compatible = "zmk,behavior-mclk-alt";
			display-name = "Middle undecided (ball=MCLK, encoder=Alt)";
			#binding-cells = <0>;
			motion-threshold = <2>;
		};

		mea: middle-encoder-alt {
			compatible = "zmk,behavior-middle-encoder-alt";
			display-name = "Encoder Alt+Tab chord (while middle held)";
			#binding-cells = <1>;
		};
	};
};
