/*
 * App switch: two modes.
 *
 * Default (middle-gated): undecided middle — ball = MCLK drag, encoder =
 * hold Alt for the session + Tab each detent (`&mea`). Alt uses stock
 * `&kt_on` / `&kt_off` (ZMK's documented Alt-Tab mechanism). Release middle
 * to commit.
 *
 * Edit / Excel: Callum/urob swapper via zmk-tri-state (`&swap` / reverse
 * with ignored LS(TAB)). Other keys end the session (no timer flake).
 */

#include <dt-bindings/zmk/keys.h>

/ {
	behaviors {
		/* Stock key-toggle on/off — same primitive the swapper uses. */
		kt_on: key_toggle_on {
			compatible = "zmk,behavior-key-toggle";
			#binding-cells = <1>;
			display-name = "Key Toggle On";
			toggle-mode = "on";
		};

		kt_off: key_toggle_off {
			compatible = "zmk,behavior-key-toggle";
			#binding-cells = <1>;
			display-name = "Key Toggle Off";
			toggle-mode = "off";
		};

		/*
		 * Classic swapper: start = kt Alt + Tab, continue = Tab,
		 * interrupt (other key) = kt Alt off.
		 * https://github.com/dhruvinsh/zmk-tri-state
		 * Pos 10 = left-encoder CW (LS(TAB)) — ignored so reverse works.
		 */
		swap: swapper {
			compatible = "zmk,behavior-tri-state";
			#binding-cells = <0>;
			display-name = "Alt-Tab swapper";
			bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;
			ignored-key-positions = <10>;
		};

		mca: mclk-alt {
			compatible = "zmk,behavior-mclk-alt";
			display-name = "Middle undecided (ball=MCLK, encoder=Alt)";
			#binding-cells = <0>;
			motion-threshold = <2>;
		};

		mea: middle-encoder-alt {
			compatible = "zmk,behavior-middle-encoder-alt";
			display-name = "Encoder Tab while middle holds Alt";
			#binding-cells = <1>;
		};
	};
};
