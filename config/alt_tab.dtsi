/*
 * App switch: two modes.
 *
 * Default layer (main use): hold middle-click for physical Left Alt, spin the
 * left encoder for Tab / Shift+Tab. No auto-hold timer — Alt can't get "lost"
 * and commit is instant on release.
 *
 * Edit / Excel: keep the encoder Alt-Tab swapper (`&at`) with a short commit
 * window; every tick re-asserts Alt so mid-session drops recover.
 */

#include <dt-bindings/zmk/keys.h>

/ {
	behaviors {
		at: alt_tab {
			compatible = "zmk,behavior-alt-tab";
			display-name = "Alt-Tab (app switch)";
			#binding-cells = <1>;
			hold-key = <LEFT_ALT>;
			/* Short so the switcher commits quickly after you stop spinning.
			 * Alt is re-asserted on every tick (see behavior_alt_tab.c). */
			release-after-ms = <450>;
		};

		/* Hold = Left Alt (use with left encoder Tab), tap = middle click. */
		altht: alt-hold-tap {
			compatible = "zmk,behavior-hold-tap";
			display-name = "Hold Alt / tap middle click";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <180>;
			hold-while-undecided;
			bindings = <&kp>, <&mkp>;
		};
	};
};
