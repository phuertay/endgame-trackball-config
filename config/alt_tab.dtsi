/*
 * Left encoder Alt-Tab.
 *
 * CW taps Tab, CCW taps Shift+Tab. The two directions undo each other while
 * Alt is held: roll back the same number of detents and the highlight returns.
 * Alt is pressed on the first detent and stays down across both directions.
 * It releases after release-after-ms of idle, or when another key is pressed.
 *
 * Do not split the directions across a tri-state swapper and a raw Shift+Tab.
 * That path emits Alt once, then bare Tab / Shift+Tab: the follower never
 * raises the position events the swapper uses to keep Alt held.
 */

#include <dt-bindings/zmk/keys.h>

/ {
	behaviors {
		at: alt_tab {
			compatible = "zmk,behavior-alt-tab";
			#binding-cells = <1>;
			display-name = "Alt-Tab";
			hold-key = <LEFT_ALT>;
			release-after-ms = <750>;
		};
	};
};
