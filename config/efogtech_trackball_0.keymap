#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/adaptive_feedback.h>
#include <dt-bindings/zmk/bistable_behavior.h>
#include <dt-bindings/zmk/p2sm.h>

#ifndef LAYER_DEFAULT
#define LAYER_DEFAULT      0
#define LAYER_EDIT         1
#define LAYER_SYSTEM       2
#define LAYER_SCROLL       3
#define LAYER_SNIPE        4
#define LAYER_EXCEL        5
#define LAYER_MEDIA        6
#endif

// Clipboard keys (copy/paste/cut/undo) remapped for the Terminator and Neu layouts.
#include "clipboard_layouts.dtsi"
// `ltlk`: Escape button that locks the scroll layer on double-tap (needs LAYER_SCROLL above).
#include "scroll_lock.dtsi"
// Advanced scaling: make both bistable "OS" slots use the same snipe/twist/dragscroll divisors.
#include "scaling.dtsi"
// `at`: left-encoder Alt-Tab app switcher (default layer only).
#include "alt_tab.dtsi"
// `pv` (paste-values) and `unclose` (reopen tab): layout-aware bistable shortcuts.
#include "edit_extras.dtsi"
// Combos (e.g. top two buttons -> Excel toggle-lock).
#include "combos.dtsi"

/ {
	keymap {
		compatible = "zmk,keymap";

		// pos0 -> Snipe (tap Enter / hold momentary / double-tap lock),
		// pos1 -> Scroll (tap Esc / hold momentary / double-tap lock),
		// hold pos3 -> Edit, hold pos6 -> Media, hold pos7 -> System;
		// combo 0+1 -> Excel. Trackball layers (Scroll/Snipe) are sticky;
		// shortcut layers (Edit/Media/System) are momentary (only while held).
		default_layer {
			display-name = "Default";
			DECLARE_ENCODERS;
			bindings = <
			    &snlk                     &ltlk
			    &mkp MCLK                 &cdch LAYER_EDIT 0
			    &mkp LCLK                 &mkp RCLK
			    &ltm LAYER_MEDIA MB4      &ltm LAYER_SYSTEM MB5

			    // encoders: left = Alt-Tab app switch, right = tab switch
			    &at TAB                   &kp RC(TAB)
			    &at LS(TAB)               &kp RC(LS(TAB))
		    >;
		};

		// Edit: clipboard/text keys. Reached by holding the copy/paste button (pos3).
		edit_layer {
			display-name = "Edit";
			DECLARE_ENCODERS;
			bindings = <
			    &kp BSPC       &bst_undo
			    &bst_cut       &trans
			    &pv            &kp PSCRN
			    &kp RC(A)      &unclose

			    // encoders
			    &kp DEL        &kp TAB
			    &kp SPACE      &kp TAB
		    >;
		};

		// System: connectivity / OS / power (infrequent). Reached by holding pos7.
		system_layer {
			display-name = "System";
			DECLARE_ENCODERS;
			bindings = <
			    &mui_or_dgl          &bt BT_CLR
			    &bst_tog ZBS_TOG     &bt BT_NXT
			    &af_toggle AF_TOG    &soft_off
			    &trans               &trans

			    &trans   &trans
			    &trans   &trans
		    >;
		};

		scroll_layer {
			display-name = "Scroll";
			DECLARE_ENCODERS;
			bindings = <
			    &trans     &tog LAYER_SCROLL
			    &trans     &kp RCTRL
			    &trans     &trans
			    &trans     &trans

			    // encoders (arrows): left = Left/Right, right = Up/Down
			    &kp LEFT   &kp UP
			    &kp RIGHT  &kp DOWN
		    >;
		};

		// Snipe: sticky trackball layer. pos0 single-tap unlocks (drops out).
		snipe_layer {
			display-name = "Snipe";
			DECLARE_ENCODERS;
			bindings = <
			    &tog LAYER_SNIPE  &trans
			    &trans     &trans
			    &trans     &trans
			    &trans     &trans

			    &kp LEFT   &kp RIGHT
			    &kp RIGHT  &kp LEFT
		    >;
		};

		// Excel: reached by combo (top two buttons); tap Back (pos7) to leave.
		// These fire Quick-Access-Toolbar buttons via Alt+<position>. Digits
		// aren't remapped by the Terminator/Neu layouts, so a single &kp works
		// for both (no bistable macro needed). Confirm the numbers by tapping
		// Alt in Excel -- keytips appear over each QAT button:
		//   Alt+1 Paste Formatting, Alt+3 Paste Formulas, Alt+6 Copy as Picture
		//   Alt+7 Paste & Reverse Transpose  (position after the AutoSave
		//         toggle -- verify; may be Alt+8 if AutoSave takes a number)
		// pos3 (Paste & Transpose Values) has no QAT button yet -> add one in
		// an early slot, then bind &kp LA(N<slot>) here.
		excel_layer {
			display-name = "Excel";
			DECLARE_ENCODERS;
			bindings = <
			    &kp LA(N1)   &kp LA(N3)
			    &kp LA(N7)   &trans
			    &kp LA(N6)   &trans
			    &trans       &to LAYER_DEFAULT

			    &trans   &trans
			    &trans   &trans
		    >;
		};

		// Media: reached by holding pos6.
		media_layer {
			display-name = "Media";
			DECLARE_ENCODERS;
			bindings = <
			    &kp C_PP        &trans
			    &kp C_PREV      &kp C_NEXT
			    &trans          &trans
			    &trans          &to LAYER_DEFAULT

			    // encoders: left = volume
			    &kp C_VOL_UP    &trans
			    &kp C_VOL_DN    &trans
		    >;
		};
	};

	trackball {
		input-processors = <&zip_bistable_twist_scaler>,
						   <&zip_pointer_accel>, <&zip_scroll_accel>, <&zip_rotate_pointer>,
		                   <&esb_ip>, <&zip_ble_report_rate_limit>;

		scroll {
			layers = <LAYER_SCROLL>;
			input-processors = <&zip_bistable_scroll_xy_scaler>, <&zip_axis_clamper>,
							   <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
							   <&zip_dragscroll_accel>, <&zip_rotate_scroll>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};

		snipe {
			layers = <LAYER_SNIPE>;
			input-processors = <&zip_bistable_snipe_scaler>, <&zip_rotate_pointer>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};
	};
};

// keymap-shell is disabled (Studio cluster removed); disable its switch-keymap
// behavior so its keymap_restore/activate_slot references compile out.
&skmp { status = "disabled"; };
