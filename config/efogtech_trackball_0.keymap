#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/adaptive_feedback.h>
#include <dt-bindings/zmk/bistable_behavior.h>
#include <dt-bindings/zmk/p2sm.h>

#ifndef LAYER_DEFAULT
#define LAYER_DEFAULT      0
#define LAYER_EDIT         1
#define LAYER_SYSTEM       2
#define LAYER_SCROLL       3
#define LAYER_SNIPE        4
#define LAYER_EXCEL        5
#define LAYER_MEDIA        6
#define LAYER_PV_CAL       7
#endif

#include "clipboard_layouts.dtsi"
#include "scroll_lock.dtsi"
#include "scaling.dtsi"
#include "alt_tab.dtsi"
#include "edit_extras.dtsi"
#include "pv_cal.dtsi"
#include "combos.dtsi"

/ {
	keymap {
		compatible = "zmk,keymap";

		// pos0 -> Media hold / Enter tap, pos1 -> Scroll lock,
		// pos2 -> middle click, hold pos3 -> Edit,
		// pos6 -> Snipe sticky / Back tap,
		// pos7 -> Close tap / System hold / Reload double-tap.
		default_layer {
			display-name = "Default";
			DECLARE_ENCODERS;
			bindings = <
			    &ltmkp LAYER_MEDIA ENTER  &ltlk
			    &mkp MCLK                 &cdch LAYER_EDIT 0
			    &mkp LCLK                 &mkp RCLK
			    &snlk                     &syslk

			    // left = Alt held + Tab / Shift+Tab; right = browser tabs
			    &at TAB                   &kp RC(PG_UP)
			    &at LS(TAB)               &kp RC(PG_DN)
		    >;
		};

		// Edit: hold the copy/paste button (pos3). pos3 itself must be &trans
		// so the hold key stays usable — Delete lives on pos1 next to Bksp.
		edit_layer {
			display-name = "Edit";
			DECLARE_ENCODERS;
			bindings = <
			    &kp BSPC       &kp DEL
			    &bst_cut       &trans
			    &pv            &kp PSCRN
			    &bst_undo      &unclose

			    &at TAB        &kp RC(PG_UP)
			    &at LS(TAB)    &kp RC(PG_DN)
		    >;
		};

		system_layer {
			display-name = "System";
			DECLARE_ENCODERS;
			bindings = <
			    &mui_or_dgl          &bt BT_CLR
			    &bst_tog ZBS_TOG     &bt BT_NXT
			    &af_toggle AF_TOG    &bt BT_PRV
			    &soft_off            &trans

			    &sens P2SM_INC 1     &scrlsens P2SM_INC 1
			    &sens P2SM_DEC 1     &scrlsens P2SM_DEC 1
		    >;
		};

		scroll_layer {
			display-name = "Scroll";
			DECLARE_ENCODERS;
			bindings = <
			    &trans     &tog LAYER_SCROLL
			    &axlk      &kp RCTRL
			    &trans     &trans
			    &trans     &trans

			    &kp LEFT   &kp UP
			    &kp RIGHT  &kp DOWN
		    >;
		};

		snipe_layer {
			display-name = "Snipe";
			DECLARE_ENCODERS;
			bindings = <
			    &trans     &trans
			    &trans     &trans
			    &trans     &trans
			    &tog LAYER_SNIPE  &trans

			    &kp LEFT   &kp UP
			    &kp RIGHT  &kp DOWN
		    >;
		};

		excel_layer {
			display-name = "Excel";
			DECLARE_ENCODERS;
			bindings = <
			    &qat1        &qat3
			    &qat8        &cdc
			    &mkp LCLK    &ptv
			    &qat6        &to LAYER_DEFAULT

			    &at TAB        &kp RC(PG_UP)
			    &at LS(TAB)    &kp RC(PG_DN)
		    >;
		};

		media_layer {
			display-name = "Media";
			DECLARE_ENCODERS;
			bindings = <
			    &trans          &trans
			    &kp C_PREV      &kp C_NEXT
			    &trans          &trans
			    &kp C_PLAY      &to LAYER_DEFAULT

			    &kp C_VOL_UP    &kp RC(PG_UP)
			    &kp C_VOL_DN    &kp RC(PG_DN)
		    >;
		};

		/*
		 * TEMP: Neu paste-values timing cal ROUND 3 (combo pos6+7).
		 * Round 2: Enter floor (350,400]; Win ≤100. See config/pv_cal.dtsi.
		 */
		pv_cal_layer {
			display-name = "PV Cal";
			DECLARE_ENCODERS;
			bindings = <
			    &pv_e360       &pv_e375
			    &pv_e390       &pv_e400w250
			    &pv_e400w100   &pv_e400w150
			    &pv_e450w100   &to LAYER_DEFAULT

			    &at TAB        &kp RC(PG_UP)
			    &at LS(TAB)    &kp RC(PG_DN)
		    >;
		};
	};

	trackball {
		input-processors = <&zip_bistable_twist_scaler>,
						   <&zip_pointer_accel>, <&zip_scroll_accel>, <&zip_rotate_pointer>,
		                   <&esb_ip>, <&zip_ble_report_rate_limit>;

		scroll {
			layers = <LAYER_SCROLL>;
			input-processors = <&zip_bistable_scroll_xy_scaler>, <&zip_axis_clamper>,
							   <&zip_axis_lock>,
							   <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
							   <&zip_dragscroll_accel>, <&zip_rotate_scroll>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};

		snipe {
			layers = <LAYER_SNIPE>;
			input-processors = <&zip_bistable_snipe_scaler>, <&zip_rotate_pointer>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};
	};
};

&skmp { status = "disabled"; };
