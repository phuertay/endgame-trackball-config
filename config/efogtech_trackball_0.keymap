#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/adaptive_feedback.h>
#include <dt-bindings/zmk/bistable_behavior.h>
#include <dt-bindings/zmk/p2sm.h>

#ifndef LAYER_DEFAULT
#define LAYER_DEFAULT      0
#define LAYER_EDIT         1
#define LAYER_SYSTEM       2
#define LAYER_SCROLL       3
#define LAYER_SNIPE        4
#define LAYER_EXCEL        5
#define LAYER_MEDIA        6
#define LAYER_ALTTAB       7
#endif

#include "clipboard_layouts.dtsi"
#include "scroll_lock.dtsi"
#include "scaling.dtsi"
#include "edit_extras.dtsi"
#include "combos.dtsi"

/ {
	keymap {
		compatible = "zmk,keymap";

		// pos0 -> Media hold / Enter tap, pos1 -> Scroll lock,
		// pos2 -> middle click, hold pos3 -> Edit,
		// pos6 -> Snipe sticky / Back tap,
		// pos7 -> Close tap / System hold / Reload double-tap.
		default_layer {
			display-name = "Default";
			DECLARE_ENCODERS;
			bindings = <
			    &ltmkp LAYER_MEDIA ENTER  &ltlk
			    &mkp MCLK                 &cdch LAYER_EDIT 0
			    &mkp LCLK                 &mkp RCLK
			    &snlk                     &syslk

			    // left = Alt+Shift+Esc / Alt+Esc; right = browser tabs
			    &kp LA(LS(ESC))           &kp RC(PG_UP)
			    &kp LA(ESC)               &kp RC(PG_DN)
		    >;
		};

		// Edit: hold the copy/paste button (pos3). pos3 itself must be &trans
		// so the hold key stays usable — Delete lives on pos1 next to Bksp.
		// Hold Bksp: Alt down + LAYER_ALTTAB (encoders Tab / Shift+Tab); release Alt up.
		edit_layer {
			display-name = "Edit";
			DECLARE_ENCODERS;
			bindings = <
			    &bspc_at BSPC  &kp DEL
			    &bst_cut       &trans
			    &pv            &kp PSCRN
			    &bst_undo      &unclose

			    &kp LA(LS(ESC)) &kp RC(PG_UP)
			    &kp LA(ESC)     &kp RC(PG_DN)
		    >;
		};

		system_layer {
			display-name = "System";
			DECLARE_ENCODERS;
			bindings = <
			    &mui_or_dgl          &bt BT_CLR
			    &bst_tog ZBS_TOG     &bt BT_NXT
			    &af_toggle AF_TOG    &bt BT_PRV
			    &soft_off            &to LAYER_DEFAULT

			    &sens P2SM_INC 1     &scrlsens P2SM_INC 1
			    &sens P2SM_DEC 1     &scrlsens P2SM_DEC 1
		    >;
		};

		scroll_layer {
			display-name = "Scroll";
			DECLARE_ENCODERS;
			bindings = <
			    // pos1 stays &trans so default &ltlk (incl. 2× lock/unlock) flows through
			    &trans     &trans
			    &axlk      &kp RCTRL
			    &trans     &trans
			    &trans     &to LAYER_DEFAULT

			    &kp LEFT   &kp UP
			    &kp RIGHT  &kp DOWN
		    >;
		};

		snipe_layer {
			display-name = "Snipe";
			DECLARE_ENCODERS;
			bindings = <
			    &trans     &trans
			    &trans     &trans
			    &trans     &trans
			    // pos6 stays &trans so default &snlk (incl. 2× lock/unlock) flows through
			    &trans     &to LAYER_DEFAULT

			    &kp LEFT   &kp UP
			    &kp RIGHT  &kp DOWN
		    >;
		};

		excel_layer {
			display-name = "Excel";
			DECLARE_ENCODERS;
			bindings = <
			    &qat1        &qat3
			    &qat8        &cdc
			    &mkp LCLK    &ptv
			    &qat6        &to LAYER_DEFAULT

			    &kp LA(LS(ESC)) &kp RC(PG_UP)
			    &kp LA(ESC)     &kp RC(PG_DN)
		    >;
		};

		media_layer {
			display-name = "Media";
			DECLARE_ENCODERS;
			bindings = <
			    &trans          &trans
			    &kp C_PREV      &kp C_NEXT
			    &trans          &trans
			    &kp C_PP        &to LAYER_DEFAULT

			    &kp C_VOL_UP    &kp RC(PG_UP)
			    &kp C_VOL_DN    &kp RC(PG_DN)
		    >;
		};

		// Momentary while Edit Bksp is held (&bspc_at). Alt is held by the
		// macro; encoders send Tab / Shift+Tab for the OS app switcher.
		// CW = Tab (next), CCW = Shift+Tab (prev) on both sides.
		alttab_layer {
			display-name = "Alt+Tab";
			DECLARE_ENCODERS;
			bindings = <
			    &trans     &trans
			    &trans     &trans
			    &trans     &trans
			    &trans     &trans

			    &kp LS(TAB) &kp TAB
			    &kp TAB     &kp LS(TAB)
		    >;
		};
	};

	trackball {
		input-processors = <&zip_bistable_twist_scaler>,
						   <&zip_pointer_accel>, <&zip_scroll_accel>, <&zip_rotate_pointer>,
		                   <&esb_ip>, <&zip_ble_report_rate_limit>;

		scroll {
			layers = <LAYER_SCROLL>;
			input-processors = <&zip_bistable_scroll_xy_scaler>, <&zip_axis_clamper>,
							   <&zip_axis_lock>,
							   <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
							   <&zip_dragscroll_accel>, <&zip_rotate_scroll>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};

		snipe {
			layers = <LAYER_SNIPE>;
			input-processors = <&zip_bistable_snipe_scaler>, <&zip_rotate_pointer>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};
	};
};

&skmp { status = "disabled"; };
